<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OVSD.Host</RootNamespace>
    <AssemblyName>OVSD</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Open Virtual Stream Deck</Product>
    <AssemblyTitle>Open Virtual Stream Deck</AssemblyTitle>
    <Description>Virtual stream deck server: runs the actions and serves the deck to phones and tablets.</Description>
    <ApplicationIcon Condition="Exists('ovsd.ico')">ovsd.ico</ApplicationIcon>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- The client is served from embedded resources, not as ASP.NET static web assets. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ovsd.ico" Condition="Exists('ovsd.ico')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="wwwroot\**\*" />
    <!-- WinForms is only used by the tray icon; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OVSD.Core\OVSD.Core.csproj" />
    <ProjectReference Include="..\OVSD.Platform.Windows\OVSD.Platform.Windows.csproj" />
    <ProjectReference Include="..\OVSD.Integrations\OVSD.Integrations.csproj" />
  </ItemGroup>

</Project>
